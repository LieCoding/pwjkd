<mxfile host="app.diagrams.net" modified="2026-05-31T00:00:00.000Z" agent="5.0" etag="drawio-export" version="22.1.0" type="device">
  <diagram name="开关健康度评估与智能体处置流程" id="switch-health-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 开始 -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- 数据接入 -->
        <mxCell id="dataAccess" value="数据接入" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="360" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="ocsDB" value="OCS三区历史库&#10;台账（厂家/投运时间）&#10;运行（在线率/遥控失败）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="dataAccess">
          <mxGeometry x="20" y="40" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="kafka" value="三区Kafka集群&#10;断面遥信遥测&#10;SOE问题信号" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="dataAccess">
          <mxGeometry x="200" y="40" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- 融合 -->
        <mxCell id="fusion" value="按开关/终端融合数据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="330" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- 开关系数 -->
        <mxCell id="coefficient" value="获取开关系数K&#10;自愈线路/分段/联络/频繁跳闸 → 高K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="450" y="410" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- 健康度评分 -->
        <mxCell id="score" value="健康度评分（每开关）&#10;基础分 = f(在线率, 遥控失败次数, SOE问题信号, 其它维度)&#10;总分 = 基础分 × K" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- 判断 -->
        <mxCell id="decision" value="总分 &lt; 合理阈值?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="610" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- 正常结束 -->
        <mxCell id="normal" value="正常，不输出异常" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="680" y="625" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="endNormal" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="710" y="710" width="60" height="40" as="geometry"/>
        </mxCell>

        <!-- 异常输出 -->
        <mxCell id="abnormal" value="输出异常数据&#10;开关ID + 开关类型 + K值 + 各维度扣分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="200" y="720" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- 智能体 -->
        <mxCell id="agent" value="智能体分析处置" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="810" width="460" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="agent1" value="匹配高K开关历史案例" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="agent">
          <mxGeometry x="20" y="40" width="120" height="40" as="geometry"/>
