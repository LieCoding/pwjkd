          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edge6" value="是（异常）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="decision" target="abnormal">
          <mxGeometry relative="1" as="geometry">
